{
  "version": 2,
  "builds": [
    {
      "src": "main.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dist/**", "ts/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.ts"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/main.ts"
    }
  ]
}